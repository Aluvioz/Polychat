# Configure estes valores nos ambientes autorizados.
# A chave publishable pode ser exposta no browser; a secret é exclusiva do servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Nunca usar NEXT_PUBLIC_ e nunca enviar como Authorization: Bearer.
SUPABASE_SECRET_KEY=
